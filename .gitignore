# Buildprodukte (SPEC §11: keine Binaries im Repo)
/target/

# Portables Laufzeitverzeichnis (SPEC §5) — entsteht erst beim Start der App
/Data/

# Auslieferungs-Binaries (lokale Archivarbeitskopie, nicht im Repo)
/delivery/

# Alte Screenshot-Sätze — gehören in die lokale Archivarbeitskopie
/screenshots/-alt/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Cargo-Build-Cache im projektlokalen .cargo/ (entsteht beim Build, kein CARGO_HOME)
/.cargo/.global-cache
/.cargo/.package-cache
/.cargo/.package-cache-mutate
/.cargo/registry/
# Maschinenspezifische Build-Konfiguration: nur .cargo/config.toml.example
# ist committet (Vorlage, s. docs/BUILD.md §1.2)
/.cargo/config.toml

# QA/Beleg-Werkzeug (dev/) — lokale Archivarbeitskopie, nicht im Repo (SPEC §11)
/dev/
